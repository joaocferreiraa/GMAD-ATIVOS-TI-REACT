# Copie este arquivo para .env.local e preencha com as credenciais do projeto Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Servidor RustDesk para o botão "Acessar máquina" do inventário.
# Vazio (ou ausente) = servidor público do RustDesk, o padrão de quem acabou
# de instalar. Preencha para apontar a um servidor próprio auto-hospedado.
# VITE_RUSTDESK_SERVIDOR=rustdesk.suaempresa.com.br
