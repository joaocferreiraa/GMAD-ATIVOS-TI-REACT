SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-publica
AGENT_EMAIL=agente.monitoramento@gmad.ti
AGENT_PASSWORD=defina-uma-senha-forte-so-para-essa-conta

# --- Métricas da máquina onde o agente roda (opcional) ---------------------
# Nome amigável desta máquina no painel de infraestrutura. Sem isso, aparece
# o hostname do sistema operacional.
AGENT_HOST_LABEL=Servidor de TI
# Intervalo de coleta de CPU/memória/disco, em segundos. 0 desliga a coleta
# (o monitoramento de rede por ping continua funcionando normalmente).
HOST_METRICS_INTERVAL_SEGUNDOS=60

# --- Agente de INVENTÁRIO (inventario.js) ---------------------------------
# Roda como tarefa agendada (não como serviço) nas máquinas do parque e
# coleta as specs completas: placa, CPU, pentes de RAM, discos, GPU, rede e
# programas instalados. Ver agent/README-INVENTARIO.md.
#
# Atraso aleatório (em segundos) antes de coletar. Com dezenas de máquinas
# ligando no mesmo horário, evita que todas gravem no Supabase ao mesmo
# tempo — cada uma sorteia o próprio atraso dentro desse limite. 0 desliga.
INVENTARIO_ATRASO_MAXIMO_SEGUNDOS=120
